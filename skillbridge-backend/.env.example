# Copy to .env (git-ignored) or export these before running the backend.
DB_URL=jdbc:mysql://localhost:3306/skillbridge?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=

CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads

# First admin account, created on startup if it doesn't exist yet
ADMIN_EMAIL=
ADMIN_PASSWORD=
